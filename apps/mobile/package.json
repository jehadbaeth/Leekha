{
  "name": "@leekha/mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Android + iOS shell around the apps/web build (Capacitor).",
  "scripts": {
    "build:web": "node ./scripts/build-web.mjs",
    "sync": "pnpm run build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "pnpm run sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
